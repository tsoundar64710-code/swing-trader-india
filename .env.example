# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# The initial release requires NO API keys. Fields below are placeholders
# for optional future features only.

# Optional: future licensed market-data provider key (leave blank)
MARKET_DATA_API_KEY=

# Optional: future broker API (live trading is DISABLED in this release)
GROWW_API_KEY=
GROWW_API_SECRET=

# Application
SWINGTRADER_ENV=development
